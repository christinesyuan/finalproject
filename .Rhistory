prob_win <- function(p, B =10000){
result <- replicate(B, {
b_win <- sample(c(1,0), 7, replace = TRUE, prob = c(1 - p, p))
sum(b_win) >= 4
})
mean(result)
}
p <- seq(0.5, 0.95, 0.025)
ws <- sapply(p, prob_win)
head(ws)
plot(ws)
plot(p, ws)
plot(p, ws, type = "l")
plot(p, ws, type = "l", col = "hotpink")
prob_win <- function(p, B =10000){
result <- replicate(B, {
b_win <- sample(c(1,0), 7, replace = TRUE, prob = c(1 - p, p))
sum(b_win) >= 4
})
mean(result)
}
p <- seq(0.5, 0.95, 0.025)
ws <- sapply(p, prob_win)
plot(p, ws, type = "l", col = "hotpink", xlab = "Probability that Team A Wins Each Game", ylab = "Series Win Probability")
